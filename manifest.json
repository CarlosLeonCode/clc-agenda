{
  "manifest_version": 3,
  "name": "CLC Agenda",
  "version": "1.3.0",
  "description": "Saca tus contactos de WhatsApp Web y guárdalos en Google Contacts o en el celular. Tu agenda, sin depender de WhatsApp.",
  "minimum_chrome_version": "111",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "CLC Agenda",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "dist/overlay.js",
        "dist/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "dist/inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
