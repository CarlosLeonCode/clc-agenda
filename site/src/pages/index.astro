---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Steps from '../components/Steps.astro';
import Panels from '../components/Panels.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import { appNodes } from '../data/structured.js';
---
<Base lang="es" page="home" graph={appNodes(Astro.site, 'es')}>
  <Nav lang="es" page="home" />
  <main id="contenido">
    <Hero lang="es" />
    <Marquee lang="es" />
    <Steps lang="es" />
    <Panels lang="es" />
    <Faq lang="es" />
    <FinalCta lang="es" />
  </main>
  <Footer lang="es" />
  <script>
    import '../scripts/motion.js';
    import '../scripts/hero-video.js';
  </script>
</Base>
