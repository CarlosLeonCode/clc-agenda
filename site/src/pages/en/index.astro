---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Hero from '../../components/Hero.astro';
import Marquee from '../../components/Marquee.astro';
import Steps from '../../components/Steps.astro';
import Panels from '../../components/Panels.astro';
import Faq from '../../components/Faq.astro';
import FinalCta from '../../components/FinalCta.astro';
import Footer from '../../components/Footer.astro';
import LeadsCard from '../../components/LeadsCard.astro';
import { appNodes } from '../../data/structured.js';
---
<Base lang="en" page="home" graph={appNodes(Astro.site, 'en')}>
  <Nav lang="en" page="home" />
  <main id="contenido">
    <Hero lang="en" />
    <Marquee lang="en" />
    <Steps lang="en" />
    <Panels lang="en" />
    <Faq lang="en" />
    <FinalCta lang="en" />
  </main>
  <Footer lang="en" leads />
  <LeadsCard lang="en" variant="floating" source="home" invite={false} />
  <script>
    import '../../scripts/motion.js';
    import '../../scripts/hero-video.js';
    import '../../scripts/leads.js';
  </script>
</Base>
