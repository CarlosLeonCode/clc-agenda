---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { DOWNLOAD_URL } from '../data/site.js';

const TITLE = 'Instalar CLC Agenda · Guía paso a paso';
const DESCRIPTION = 'Instala CLC Agenda en tu navegador en 7 pasos simples, sin saber de tecnología: descarga, descomprime y carga la extensión en Chrome, Brave, Edge u Opera.';
const EXTENSIONS_URL = 'chrome://extensions';
---
<Base title={TITLE} description={DESCRIPTION} path="/instalar" structuredData={false}>
  <Nav />
  <main id="contenido" class="guide">
    <header class="guide-head wrap">
      <p class="guide-kicker">Guía de instalación</p>
      <h1 class="guide-title">Instala CLC Agenda en 7 pasos</h1>
      <p class="guide-lead">No necesitas saber de tecnología. Toma unos 3 minutos y funciona en Chrome, Brave, Edge y Opera.</p>
    </header>

    <ol class="steps-guide wrap">
      <li class="step-card">
        <div class="step-text">
          <span class="step-num" aria-hidden="true">1</span>
          <h2>Descarga el archivo</h2>
          <p>Toca el botón. Se descarga un archivo llamado <strong>clc-agenda.zip</strong>, normalmente en tu carpeta Descargas.</p>
          <a class="btn download-btn" href={DOWNLOAD_URL}>Descargar CLC Agenda</a>
          <p class="hint">Archivo .zip de unos 35 KB. Siempre es la última versión.</p>
        </div>
        <div class="illo" aria-hidden="true">
          <div class="illo-file">
            <svg viewBox="0 0 48 60" width="64" height="80"><path d="M4 4h28l12 12v40H4z" fill="#fff" stroke="#0F0F10" stroke-width="3" stroke-linejoin="round" /><path d="M32 4v12h12" fill="none" stroke="#0F0F10" stroke-width="3" stroke-linejoin="round" /><rect x="12" y="30" width="24" height="14" rx="4" fill="#6A4FF5" /><text x="24" y="40.5" text-anchor="middle" font-size="9" font-weight="700" fill="#fff" font-family="Inter Variable, sans-serif">ZIP</text></svg>
            <span>clc-agenda.zip</span>
          </div>
          <div class="illo-arrow">
            <svg viewBox="0 0 24 24" width="40" height="40"><path d="M12 4v12M6 11l6 6 6-6M5 20h14" fill="none" stroke="#0F0F10" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </div>
        </div>
      </li>

      <li class="step-card">
        <div class="step-text">
          <span class="step-num" aria-hidden="true">2</span>
          <h2>Descomprímelo y guarda la carpeta</h2>
          <p><strong>En Windows:</strong> haz clic derecho sobre el archivo y elige «Extraer todo». <strong>En Mac:</strong> haz doble clic.</p>
          <p>Aparece una carpeta llamada <strong>clc-agenda</strong>. Muévela a un lugar donde no la vayas a borrar, como Documentos: el navegador la usa mientras la extensión esté instalada.</p>
        </div>
        <div class="illo illo-unzip" aria-hidden="true">
          <div class="mini-window">
            <span class="mini-label">Windows</span>
            <div class="menu"><span>Abrir</span><span class="is-on">Extraer todo…</span><span>Copiar</span></div>
          </div>
          <div class="mini-window">
            <span class="mini-label">Mac</span>
            <div class="folder-row">
              <svg viewBox="0 0 48 40" width="58" height="48"><path d="M3 8a4 4 0 0 1 4-4h12l5 5h17a4 4 0 0 1 4 4v20a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4z" fill="#FFC700" stroke="#0F0F10" stroke-width="2.6" stroke-linejoin="round" /></svg>
              <span>clc-agenda</span>
            </div>
          </div>
        </div>
      </li>

      <li class="step-card">
        <div class="step-text">
          <span class="step-num" aria-hidden="true">3</span>
          <h2>Abre la página de extensiones</h2>
          <p>Copia esta dirección, pégala en la barra de direcciones del navegador y presiona Enter. Hay que escribirla o pegarla: el navegador no deja abrirla desde un enlace.</p>
          <div class="copy-row">
            <code data-copy-source>{EXTENSIONS_URL}</code>
            <button type="button" class="copy-btn" data-copy={EXTENSIONS_URL}>Copiar</button>
          </div>
          <p class="copy-status" aria-live="polite" data-copy-status></p>
          <p class="hint">¿Usas otro navegador? Brave: <code>brave://extensions</code> · Edge: <code>edge://extensions</code> · Opera: <code>opera://extensions</code></p>
        </div>
        <div class="illo" aria-hidden="true">
          <div class="browser">
            <div class="browser-bar"><i></i><i></i><i></i><span class="address">chrome://extensions<b class="caret"></b></span></div>
            <div class="browser-body"><span class="line w60"></span><span class="line w40"></span></div>
          </div>
        </div>
      </li>

      <li class="step-card">
        <div class="step-text">
          <span class="step-num" aria-hidden="true">4</span>
          <h2>Activa el «Modo de desarrollador»</h2>
          <p>Arriba a la derecha de esa página hay un interruptor con ese nombre. Actívalo: aparecen tres botones nuevos.</p>
        </div>
        <div class="illo" aria-hidden="true">
          <div class="browser">
            <div class="ext-head"><span class="ext-title">Extensiones</span><span class="dev-toggle"><span>Modo de desarrollador</span><b class="switch"></b></span></div>
            <div class="browser-body"><span class="line w60"></span><span class="line w40"></span></div>
          </div>
        </div>
      </li>

      <li class="step-card">
        <div class="step-text">
          <span class="step-num" aria-hidden="true">5</span>
          <h2>Toca «Cargar descomprimida»</h2>
          <p>Es el primer botón de la izquierda. Se abre una ventana: elige la carpeta <strong>clc-agenda</strong> que guardaste en el paso 2 y confirma.</p>
          <p class="hint">Si tu navegador está en inglés, el botón dice «Load unpacked».</p>
        </div>
        <div class="illo" aria-hidden="true">
          <div class="browser">
            <div class="ext-actions"><span class="action is-on">Cargar descomprimida</span><span class="action">Empaquetar</span><span class="action">Actualizar</span></div>
            <div class="ext-card"><span class="ext-icon"></span><span class="ext-lines"><span class="line w60"></span><span class="line w40"></span></span></div>
          </div>
        </div>
      </li>

      <li class="step-card">
        <div class="step-text">
          <span class="step-num" aria-hidden="true">6</span>
          <h2>Fija el ícono en la barra</h2>
          <p>Toca el ícono de la pieza de rompecabezas, arriba a la derecha, y luego el pin junto a CLC Agenda. Así siempre lo tienes a mano.</p>
        </div>
        <div class="illo" aria-hidden="true">
          <div class="browser">
            <div class="browser-bar"><i></i><i></i><i></i><span class="address"></span>
              <svg class="puzzle" viewBox="0 0 24 24" width="22" height="22"><path d="M9 3h4v3a2 2 0 1 0 4 0V3h3v6h-3a2 2 0 1 0 0 4h3v8H9v-3a2 2 0 1 0-4 0v3H3V9h6V6a2 2 0 1 1 0-3z" fill="#5C5C66" /></svg>
            </div>
            <div class="popover">
              <span class="pop-row"><span class="ext-icon small"></span>CLC Agenda<svg class="pin" viewBox="0 0 24 24" width="18" height="18"><path d="M9 3h6l-1 6 4 4v2h-5v6l-1 1-1-1v-6H6v-2l4-4z" fill="#6A4FF5" /></svg></span>
            </div>
          </div>
        </div>
      </li>

      <li class="step-card">
        <div class="step-text">
          <span class="step-num" aria-hidden="true">7</span>
          <h2>Abre WhatsApp Web</h2>
          <p>Entra a <strong>web.whatsapp.com</strong> e inicia sesión como siempre. Abajo a la derecha aparece el botón «Extraer contactos». Listo: ya puedes guardar tus contactos.</p>
        </div>
        <div class="illo" aria-hidden="true">
          <div class="browser chat">
            <div class="chat-list"><span class="row"></span><span class="row"></span><span class="row"></span><span class="row"></span></div>
            <span class="launcher">Extraer contactos</span>
          </div>
        </div>
      </li>
    </ol>

    <section class="trouble wrap" aria-labelledby="trouble-title">
      <h2 id="trouble-title" class="trouble-title">Si algo no funciona</h2>
      <div class="trouble-list">
        <div class="trouble-item">
          <h3>No veo el botón «Extraer contactos»</h3>
          <p>Recarga WhatsApp Web con la tecla F5 o el ícono de recargar. Si instalaste la extensión con WhatsApp Web ya abierto, hace falta recargar una vez.</p>
        </div>
        <div class="trouble-item">
          <h3>El navegador muestra un aviso sobre el modo de desarrollador</h3>
          <p>Es normal. El navegador avisa cuando una extensión se instala desde una carpeta y no desde su tienda. Puedes cerrar el aviso: la extensión sigue funcionando.</p>
        </div>
        <div class="trouble-item">
          <h3>¿Cómo actualizo a una versión nueva?</h3>
          <p>Descarga el archivo otra vez, descomprímelo y reemplaza el contenido de tu carpeta clc-agenda por el nuevo. Después, en la página de extensiones, toca la flecha circular de la tarjeta de CLC Agenda.</p>
        </div>
        <div class="trouble-item">
          <h3>¿Por qué no está en la Chrome Web Store?</h3>
          <p>Todavía no está publicada ahí. Cuando lo esté, instalarla será un solo clic y se actualizará sola.</p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <script>
    import '../scripts/copy.js';
  </script>
</Base>

<style>
  .guide { padding-bottom: 72px; }
  .guide-head { text-align: center; padding-top: 56px; padding-bottom: 40px; }
  .guide-kicker { font: 600 14px var(--body); color: var(--violet-strong); letter-spacing: .02em; margin-bottom: 14px; }
  .guide-title { font: 800 clamp(40px, 7vw, 76px)/0.95 var(--display); letter-spacing: -0.04em; }
  .guide-lead { font-size: clamp(17px, 2.2vw, 20px); color: var(--muted); max-width: 620px; margin: 20px auto 0; }

  .steps-guide { display: grid; gap: 20px; }
  .step-card { display: grid; gap: 22px; border: 2px solid var(--line); border-radius: var(--radius-lg); padding: 24px; }
  .step-text h2 { font: 800 clamp(26px, 3.6vw, 34px)/1.05 var(--display); letter-spacing: -0.03em; margin: 14px 0 10px; }
  .step-text p { color: var(--muted); max-width: 560px; }
  .step-text p + p { margin-top: 10px; }
  .step-text strong { color: var(--ink); }
  .step-num { display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--ink); color: #fff; font: 800 20px var(--display); }
  .hint { font-size: 14px; margin-top: 12px; }
  .download-btn { margin-top: 20px; }
  code { font: 600 15px ui-monospace, 'SF Mono', Menlo, monospace; background: var(--lilac); color: var(--ink); padding: 2px 8px; border-radius: 6px; }

  .copy-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 16px; }
  .copy-row code { font-size: 17px; padding: 10px 14px; border-radius: 12px; }
  .copy-btn { min-height: 44px; padding: 0 18px; border: 0; border-radius: 999px; background: var(--ink); color: #fff; font: 600 15px var(--body); cursor: pointer; }
  .copy-btn:hover { background: var(--violet-strong); }
  .copy-status { min-height: 1.5em; margin-top: 8px; font-size: 14px; color: var(--violet-strong) !important; font-weight: 600; }

  /* Illustrations: simple drawings of what the person sees, decorative only */
  .illo { background: var(--lilac); border-radius: var(--radius-md); min-height: 200px; display: flex; align-items: center; justify-content: center; gap: 18px; padding: 24px 16px; overflow: hidden; }
  .illo-file { display: flex; flex-direction: column; align-items: center; gap: 8px; font: 600 14px var(--body); }
  .illo-arrow { width: 64px; height: 64px; border-radius: 50%; background: var(--yellow); display: grid; place-items: center; }
  .illo-unzip { flex-wrap: wrap; }
  .mini-window { background: #fff; border: 2px solid var(--ink); border-radius: 14px; padding: 12px; min-width: 150px; display: flex; flex-direction: column; gap: 8px; }
  .mini-label { font: 700 12px var(--body); color: var(--muted); text-transform: uppercase; letter-spacing: .06em; }
  .menu { display: flex; flex-direction: column; gap: 2px; font-size: 14px; }
  .menu span { padding: 4px 8px; border-radius: 6px; }
  .menu .is-on { background: var(--violet-strong); color: #fff; font-weight: 600; }
  .folder-row { display: flex; align-items: center; gap: 10px; font: 600 14px var(--body); }

  .browser { width: 100%; max-width: 420px; background: #fff; border: 2px solid var(--ink); border-radius: 14px; overflow: hidden; position: relative; }
  .browser-bar { display: flex; align-items: center; gap: 6px; padding: 10px 12px; background: #F1F1F4; border-bottom: 2px solid var(--line); }
  .browser-bar i { width: 9px; height: 9px; border-radius: 50%; background: #C9C9D1; display: block; flex: none; }
  .address { flex: 1; min-width: 0; margin-left: 8px; background: #fff; border-radius: 999px; padding: 6px 12px; font: 600 12px ui-monospace, Menlo, monospace; min-height: 30px; display: flex; align-items: center; overflow: hidden; white-space: nowrap; }
  .caret { display: inline-block; width: 2px; height: 16px; background: var(--violet-strong); margin-left: 2px; }
  .browser-body { padding: 18px 14px; display: grid; gap: 10px; }
  .line { display: block; height: 10px; border-radius: 6px; background: var(--line); }
  .w60 { width: 60%; } .w40 { width: 40%; }

  .ext-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 12px 10px; border-bottom: 2px solid var(--line); }
  .ext-title { font: 700 13px var(--body); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  /* Fits a 360 px screen: the switch stays whole next to its label */
  .dev-toggle { display: flex; align-items: center; gap: 6px; font: 600 11px/1.2 var(--body); padding: 6px 8px; border-radius: 10px; box-shadow: 0 0 0 3px var(--violet-strong); flex: none; max-width: 62%; margin-right: 3px; }
  .switch { width: 34px; height: 20px; border-radius: 999px; background: var(--violet-strong); position: relative; flex: none; }
  .switch::after { content: ''; position: absolute; right: 3px; top: 3px; width: 14px; height: 14px; border-radius: 50%; background: #fff; }
  .ext-actions { display: flex; flex-wrap: wrap; gap: 8px; padding: 12px 14px; border-bottom: 2px solid var(--line); }
  .action { font: 600 12px var(--body); padding: 7px 10px; border-radius: 8px; border: 2px solid var(--line); }
  .action.is-on { border-color: var(--violet-strong); background: var(--violet-strong); color: #fff; }
  .ext-card { display: flex; gap: 12px; align-items: center; padding: 16px 14px; }
  .ext-icon { width: 34px; height: 34px; border-radius: 9px; background: var(--ink); flex: none; }
  .ext-icon.small { width: 20px; height: 20px; border-radius: 6px; }
  .ext-lines { flex: 1; display: grid; gap: 8px; }
  .puzzle { margin-left: 6px; flex: none; }
  .popover { position: absolute; right: 10px; top: 52px; background: #fff; border: 2px solid var(--ink); border-radius: 12px; padding: 8px; box-shadow: 0 10px 24px -12px rgba(15, 15, 16, .35); }
  .pop-row { display: flex; align-items: center; gap: 8px; font: 600 13px var(--body); padding: 6px 8px; }
  .pin { margin-left: 18px; border-radius: 6px; box-shadow: 0 0 0 3px var(--violet-strong); }
  .browser:has(.popover) { min-height: 150px; }

  .chat { min-height: 170px; display: flex; }
  .chat-list { width: 45%; padding: 14px; display: grid; gap: 12px; border-right: 2px solid var(--line); }
  .chat-list .row { height: 18px; border-radius: 6px; background: var(--line); }
  .launcher { position: absolute; right: 12px; bottom: 12px; background: var(--green); color: var(--ink); font: 700 13px var(--body); padding: 9px 14px; border-radius: 999px; box-shadow: 0 0 0 3px var(--violet-strong); }

  .trouble { margin-top: 64px; }
  .trouble-title { font: 800 clamp(34px, 5vw, 56px)/1 var(--display); letter-spacing: -0.04em; margin-bottom: 24px; }
  .trouble-list { display: grid; gap: 14px; }
  .trouble-item { border: 2px solid var(--line); border-radius: var(--radius-md); padding: 18px 22px; }
  .trouble-item h3 { font: 700 18px/1.3 var(--body); margin-bottom: 6px; }
  .trouble-item p { color: var(--muted); }

  @media (min-width: 640px) {
    .step-card { padding: 32px; }
    .ext-head { padding: 12px 14px; }
    .ext-title { font-size: 15px; }
    .dev-toggle { font-size: 12px; gap: 8px; }
    .trouble-list { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1024px) {
    .step-card { grid-template-columns: 1fr 1fr; align-items: center; gap: 40px; padding: 40px; }
    .illo { min-height: 240px; }
  }
</style>
