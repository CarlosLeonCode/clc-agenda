---
import { copyFor } from '../i18n/index.js';

const { lang = 'es' } = Astro.props;
const copy = copyFor(lang);
const { panels } = copy;
---
<div class="wrap duo">
  <section id={copy.ids.formats} class="panel panel-lilac" aria-labelledby="formats-title" data-panel>
    <h2 id="formats-title" class="panel-title">{panels.formatsTitle}</h2>
    <ul class="formats">
      {panels.formats.map(f => (
        <li class="fmt"><span><b>{f.name}</b><small>{f.note}</small></span><span class="tag">{f.tag}</span></li>
      ))}
    </ul>
  </section>
  <section id={copy.ids.privacy} class="panel panel-coral" aria-labelledby="privacy-title" data-panel>
    <h2 id="privacy-title" class="panel-title">{panels.privacyTitle}</h2>
    <ul class="ticks">
      {panels.ticks.map(tick => <li>{tick}</li>)}
    </ul>
  </section>
</div>
