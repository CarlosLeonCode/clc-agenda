---
import { copyFor } from '../i18n/index.js';

const { lang = 'es' } = Astro.props;
const copy = copyFor(lang);
const backgrounds = ['var(--yellow)', 'var(--sky)', 'var(--green)'];
const steps = copy.steps.items.map((s, i) => ({ ...s, n: i + 1, bg: backgrounds[i] }));
---
<section id={copy.ids.how} class="section" aria-labelledby="steps-title">
  <div class="wrap">
    <h2 id="steps-title" class="section-title" data-reveal>{copy.steps.title1}{' '}<br />{copy.steps.title2}</h2>
    <ol class="steps">
      {steps.map(s => (
        <li class="step" style={`background:${s.bg}`} data-step>
          <span class="step-n" aria-hidden="true">{s.n}</span>
          <div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
