---
import { copyFor } from '../i18n/index.js';

const { lang = 'es' } = Astro.props;
const copy = copyFor(lang);
---
<section class="final" aria-labelledby="final-title" data-leads-engage>
  <div class="wrap">
    <h2 id="final-title" class="final-title" data-reveal>{copy.finalCta.title}</h2>
    <a class="btn" href={copy.routes.install} data-reveal>{copy.finalCta.button}</a>
  </div>
</section>
