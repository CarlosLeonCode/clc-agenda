---
import { getImage } from 'astro:assets';
import posterSrc from '../assets/hero-poster.png';
import { INSTALL_URL, AUTHOR, DEFINITION } from '../data/site.js';

// Promo video (video/ project), re-encoded at 720p without audio for the web
const poster = await getImage({ src: posterSrc, width: 1280, format: 'webp', quality: 80 });
const videoBase = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/video/clc-agenda`;

// Named cursors: people from your groups, drifting toward your address book
const cursors = [
  { name: 'Ana · Ventas', color: 'var(--coral)', ink: true, cls: 'cursor-a' },
  { name: 'Bruno · Comunidad', color: 'var(--violet-strong)', ink: false, cls: 'cursor-b' },
  { name: 'Tú', color: 'var(--sky)', ink: true, cls: 'cursor-c' }
];
---
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-copy">
    {cursors.map(c => (
      <div class={`cursor ${c.cls}`} aria-hidden="true" data-cursor>
        <svg viewBox="0 0 24 24" width="26" height="26"><path d="M3 2l7 19 2.5-8L21 10z" fill={c.color} stroke="#fff" stroke-width="1.5" /></svg>
        <span style={`background:${c.color};color:${c.ink ? 'var(--ink)' : '#fff'}`}>{c.name}</span>
      </div>
    ))}
    <p class="hero-eyebrow" data-fade>Exporta contactos de WhatsApp Web</p>
    <h1 id="hero-title" class="hero-title">
      <span class="line" data-line>Tu agenda,</span>{' '}
      <span class="line" data-line><span class="hl hl-violet" data-hl>fuera</span> de <span class="hl hl-coral" data-hl>WhatsApp.</span></span>
    </h1>
    <p class="lead" data-fade>{DEFINITION}</p>
    <div class="cta-row" data-fade>
      <a class="btn" href={INSTALL_URL}>Instalar la extensión</a>
      <a class="btn btn-alt" href="#como-funciona">Ver cómo funciona</a>
    </div>
    <p class="credit-row" data-fade>
      <a class="credit" href={AUTHOR.url}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M3 2l7 19 2.5-8L21 10z" fill="var(--coral)" stroke="#fff" stroke-width="1.5" /></svg>
        <span class="credit-by">Creado por</span>
        <span class="credit-name">{AUTHOR.name}</span>
        <svg class="credit-arrow" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
    </p>
  </div>

  <div class="wrap">
    <div class="canvas" data-canvas>
      <div class="shape shape-yellow" aria-hidden="true" data-shape></div>
      <div class="shape shape-sky" aria-hidden="true" data-shape></div>
      <div class="shape shape-green" aria-hidden="true" data-shape></div>
      <div class="shot" data-shot>
        <video
          data-video
          muted
          loop
          playsinline
          controls
          preload="metadata"
          poster={poster.src}
          width="1280"
          height="720"
          aria-label="Video de 45 segundos sin audio: CLC Agenda saca los contactos de un grupo de WhatsApp Web, filtra a los que no tienes guardados y los exporta a Google Contacts o al celular."
        >
          <source src={`${videoBase}.mp4`} type="video/mp4" />
          <source src={`${videoBase}.webm`} type="video/webm" />
        </video>
        <button type="button" class="video-toggle" data-video-toggle aria-pressed="false" hidden>
          <svg data-icon="pause" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M7 5h3v14H7zM14 5h3v14h-3z" fill="currentColor" /></svg>
          <svg data-icon="play" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" hidden><path d="M8 5l11 7-11 7z" fill="currentColor" /></svg>
          <span class="video-toggle-label" data-video-label>Pausar video</span>
        </button>
        <span class="click-ripple" aria-hidden="true" data-ripple></span>
      </div>
      <div class="chip chip-1" aria-hidden="true" data-chip>+57 300 000 0000</div>
      <div class="chip chip-2" aria-hidden="true" data-chip>+52 55 0000 0000</div>
      <div class="chip chip-3" aria-hidden="true" data-chip><b>426</b> sin guardar</div>
    </div>
  </div>
</section>
