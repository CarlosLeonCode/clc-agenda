---
import { copyFor } from '../i18n/index.js';

const { lang = 'es' } = Astro.props;
const copy = copyFor(lang);
---
<section id={copy.ids.faq} class="section" aria-labelledby="faq-title">
  <div class="wrap faq-grid">
    <h2 id="faq-title" class="section-title" data-reveal>{copy.faq.title}</h2>
    <div class="faq">
      {copy.faq.items.map(({ q, a }) => (
        <details class="faq-item" data-faq>
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
