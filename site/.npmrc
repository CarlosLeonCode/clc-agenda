# @carlosleoncode packages come from GitHub Packages. The token is never committed:
# it is read from NODE_AUTH_TOKEN (a GitHub token with read:packages), set locally
# in your shell and in Netlify's environment variables. It is optional: without it npm
# skips the optional @carlosleoncode/lead-capture and the site builds without the emails.
@carlosleoncode:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
